# Database connection
DATABASE_URL=postgresql://user:password@localhost:5432/rayleigh

# Server configuration
PORT=3000
HOST=0.0.0.0

# Feed generator identity
# Get this by resolving your Bluesky handle to a DID
FEED_PUBLISHER_DID=did:plc:your-did-here

# Feed configuration
FEED_HOSTNAME=your-app.fly.dev

# Bluesky credentials (for publishing feed)
BLUESKY_HANDLE=rayleigh-feed.bsky.social
BLUESKY_APP_PASSWORD=your-app-password-here

# Bluesky authentication (for scripts that need to fetch user data)
BLUESKY_AUTH_HANDLE=your-handle.bsky.social
BLUESKY_AUTH_PASSWORD=xxxx-xxxx-xxxx-xxxx

# OpenAI API (for embeddings)
OPENAI_API_KEY=sk-your-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

# Whitelisted users (comma-separated handles for personalized feeds)
WHITELISTED_HANDLES=user1.bsky.social,user2.bsky.social

# Scoring settings (optional)
SCORING_BONUS_FACTOR=0.3
SCORING_INTERVAL_MS=60000
PREFERENCES_REFRESH_INTERVAL_MS=3600000
