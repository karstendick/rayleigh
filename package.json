{
  "name": "rayleigh",
  "version": "0.1.0",
  "description": "Semantic Bluesky feed generator",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "explore-likes": "tsx scripts/explore-likes.ts",
    "explore-likes:birch": "tsx scripts/explore-likes-birch.ts",
    "publish-feed": "tsx scripts/publishFeed.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate up --migrations-dir migrations --migration-file-language sql",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --migration-file-language sql",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@atproto/api": "^0.13.20",
    "bloom-filters": "^3.0.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-pg-migrate": "^8.0.4",
    "openai": "^6.15.0",
    "pg": "^8.13.1",
    "sklearn": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@flydotio/dockerfile": "^0.7.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "hdbscan-ts": "^1.0.16",
    "lefthook": "^2.0.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
